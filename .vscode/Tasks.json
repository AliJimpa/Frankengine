{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean",
            "type": "shell",
            "command": "${workspaceFolder}\\clean.bat",
            "args": [
                "${workspaceFolder}"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Compile",
            "type": "shell",
            "command": "${workspaceFolder}\\compile.bat",
            "args": [
                "${workspaceFolder}"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": [
                "${workspaceFolder}",
                "${workspaceFolder}\\Binaries\\Win64",
                "${workspaceFolderBasename}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Compile"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Make imgui library (static)",
            "type": "shell",
            "command": "${workspaceFolder}\\Assets\\imgui\\Build_Imgui_Library.bat",
            "args": [
                "${workspaceFolder}",
                "imgui",
                "imgui_opengl_libx86"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        }
    ]
}