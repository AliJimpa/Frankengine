{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean",
            "type": "shell",
            "command": "${workspaceFolder}\\clean.bat",
            "args": [
                "${workspaceFolder}"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Compile",
            "type": "shell",
            "command": "${workspaceFolder}\\compile.bat",
            "args": [
                "${workspaceFolder}"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": [
                "${workspaceFolder}",
                "${workspaceFolder}\\Save\\Launch",
                "${workspaceFolderBasename}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Compile"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "type": "shell",
            "label": "Run",
            "command": "cmd",
            "args": [
                "/C",
                "start ${workspaceFolder}\\Save\\Launch\\${workspaceFolderBasename}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        ///
        {
            "label": "ImGui: Build Library",
            "type": "shell",
            "command": "${workspaceFolder}\\BuildImGui.bat",
            "args": [
                "${workspaceFolder}"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}