{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prepare Build Folders",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "if not exist build\\Debug\\Intermediate\\Engine mkdir build\\Debug\\Intermediate\\Engine & if not exist build\\Debug\\Intermediate\\Runtime mkdir build\\Debug\\Intermediate\\Runtime & if not exist build\\Debug\\Intermediate\\Editor mkdir build\\Debug\\Intermediate\\Editor & if not exist build\\Debug\\Intermediate\\SampleGame mkdir build\\Debug\\Intermediate\\SampleGame & if not exist build\\Debug\\Engine mkdir build\\Debug\\Engine & if not exist build\\Debug\\Runtime mkdir build\\Debug\\Runtime & if not exist build\\Debug\\Editor mkdir build\\Debug\\Editor & if not exist build\\Debug\\SampleGame mkdir build\\Debug\\SampleGame"
            ],
            "problemMatcher": []
        },
        {
            "label": "Compile Engine (Debug)",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/c",
                "/EHsc",
                "/Zi",
                "/MDd",
                "/FS",
                "/std:c++17",
                "/I",
                "include",
                "/Fo:build\\Debug\\Intermediate\\Engine\\",
                "/Fd:build\\Debug\\Intermediate\\Engine\\Engine.pdb",
                "src\\engine\\EngineAPI.cpp"
            ],
            "dependsOn": [
                "Prepare Build Folders"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build"
        },
        {
            "label": "Lib Engine (Debug)",
            "type": "shell",
            "command": "lib.exe",
            "args": [
                "/OUT:build\\Debug\\Engine\\Engine.lib",
                "build\\Debug\\Intermediate\\Engine\\EngineAPI.obj"
            ],
            "dependsOn": [
                "Compile Engine (Debug)"
            ],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Build Runtime (Debug)",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/Zi",
                "/MDd",
                "/FS",
                "/std:c++17",
                "/I",
                "include",
                "/Fo:build\\Debug\\Intermediate\\Runtime\\",
                "/Fd:build\\Debug\\Intermediate\\Runtime\\Runtime.pdb",
                "/Fe:build\\Debug\\Runtime\\Runtime.exe",
                "src\\Kernel\\GameLauncher.cpp",
                "/link",
                "build\\Debug\\Engine\\Engine.lib"
            ],
            "dependsOn": [
                "Lib Engine (Debug)"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build"
        },
        {
            "label": "Build Editor (Debug)",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/Zi",
                "/MDd",
                "/FS",
                "/std:c++17",
                "/I",
                "include",
                "/I",
                "deps\\glfw-3.4.bin.WIN32\\include",
                "/I",
                "ext\\imgui",
                "/I",
                "ext\\imgui\\backends",
                "/Fo:build\\Debug\\Intermediate\\Editor\\",
                "/Fd:build\\Debug\\Intermediate\\Editor\\Editor.pdb",
                "/Fe:build\\Debug\\Editor\\Editor.exe",
                "src\\editor\\Editor.cpp",
                "src\\editor\\systems\\EditorGUISystem.cpp",
                "ext\\imgui\\imgui.cpp",
                "ext\\imgui\\imgui_draw.cpp",
                "ext\\imgui\\imgui_tables.cpp",
                "ext\\imgui\\imgui_widgets.cpp",
                "ext\\imgui\\imgui_demo.cpp",
                "ext\\imgui\\backends\\imgui_impl_glfw.cpp",
                "ext\\imgui\\backends\\imgui_impl_opengl3.cpp",
                "/link",
                "build\\Debug\\Engine\\Engine.lib",
                "/LIBPATH:deps\\glfw-3.4.bin.WIN32\\lib-vc2022",
                "glfw3.lib",
                "opengl32.lib",
                "user32.lib",
                "gdi32.lib",
                "shell32.lib"
            ],
            "dependsOn": [
                "Lib Engine (Debug)"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build"
        },
        {
            "label": "Build SampleGame (Debug)",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/Zi",
                "/MDd",
                "/FS",
                "/std:c++17",
                "/LD",
                "/I",
                "include",
                "/Fo:build\\Debug\\Intermediate\\SampleGame\\",
                "/Fd:build\\Debug\\Intermediate\\SampleGame\\SampleGame.pdb",
                "/Fe:build\\Debug\\SampleGame\\Game.dll",
                "Projects\\SampleGame\\SampleGame.cpp"
            ],
            "dependsOn": [
                "Prepare Build Folders"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build"
        },
        {
            "label": "Deploy Runtime -> SampleGame",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "copy /Y build\\Debug\\Runtime\\Runtime.exe build\\Debug\\SampleGame\\SampleGame.exe"
            ],
            "dependsOn": [
                "Build Runtime (Debug)",
                "Build SampleGame (Debug)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build All (Debug)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Editor (Debug)",
                "Deploy Runtime -> SampleGame"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}