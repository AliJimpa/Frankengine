{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Generate Build Folder",
            "command": "cmd",
            "args": [
                "/C",
                "mkdir build >nul 2>&1",
                "& mkdir build\\Debug >nul 2>&1",
                "& mkdir build\\Debug\\Editor >nul 2>&1",
                "& mkdir build\\Debug\\Editor\\BuildPipeline >nul 2>&1",
                "& mkdir build\\Debug\\Intermediate >nul 2>&1",
                "& mkdir build\\Debug\\Intermediate\\BuildPipeline >nul 2>&1",
                "& mkdir build\\Release >nul 2>&1",
                "& mkdir build\\Release\\Editor >nul 2>&1",
                "& mkdir build\\Release\\Editor\\BuildPipeline >nul 2>&1",
                "& mkdir build\\Release\\Intermediate >nul 2>&1",
                "& mkdir build\\Release\\Intermediate\\BuildPipeline >nul 2>&1 &"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "detail": "Create all folder need for build prject"
        },
        {
            "type": "shell",
            "label": "Build Engine (Debug)",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/EHsc",
                "/Zi",
                "/LD",
                "/D",
                "FRANKENGINE_EXPORTS",
                "/I",
                "${workspaceFolder}\\include",
                "/I",
                "${workspaceFolder}\\include\\SDK",
                "/Fo:${workspaceFolder}\\build\\Debug\\Intermediate\\EngineRuntime.obj",
                "/Fe:${workspaceFolder}\\build\\Debug\\Editor\\EngineRuntime.dll",
                "${workspaceFolder}\\src\\engine\\EngineRuntime.cpp",
                "/link",
                "/DEBUG",
                "/PDB:${workspaceFolder}\\build\\Debug\\Editor\\EngineRuntime.pdb",
                "/IMPLIB:${workspaceFolder}\\build\\Debug\\Intermediate\\EngineRuntime.lib"
            ],
            "dependsOn": "Generate Build Folder",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Compiler(CL) , SolutionConfg(Debug) , Platform(Win32[x86])"
        },
        {
            "type": "shell",
            "label": "Build Editor (Debug)",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/W4",
                "/EHsc",
                "/Zi",
                "/I${workspaceFolder}\\include",
                "/I${workspaceFolder}\\include\\Systems",
                "/I${workspaceFolder}\\include\\Editor",
                "/I${workspaceFolder}\\include\\Editor\\Core",
                "/I${workspaceFolder}\\include\\Editor\\system",
                "/I${workspaceFolder}\\include\\Engine\\Core",
                "/I${workspaceFolder}\\include\\Engine\\utility",
                "/I${workspaceFolder}\\include\\Editor\\UI",
                "/I${workspaceFolder}\\include\\Editor\\UI\\Widget",
                "/I${workspaceFolder}\\include\\Editor\\UI\\Widget\\Base",
                "/I${workspaceFolder}\\ext\\imgui",
                "/I${workspaceFolder}\\deps\\glfw-3.4.bin.WIN32\\include",
                "/I${workspaceFolder}\\build\\Debug",
                "opengl32.lib",
                "${workspaceFolder}\\deps\\glfw-3.4.bin.WIN32\\lib-vc2022\\glfw3dll.lib",
                "${workspaceFolder}/ext/imgui/*.cpp",
                "${workspaceFolder}/ext/imgui/backends/imgui_impl_glfw.cpp",
                "${workspaceFolder}/ext/imgui/backends/imgui_impl_opengl2.cpp",
                "${workspaceFolder}/src/editor/systems/*.cpp",
                "${workspaceFolder}\\src\\editor\\Editor.cpp",
                "/Fd:${workspaceFolder}\\build\\Debug\\Editor\\Editor.pdb",
                "/Fo:${workspaceFolder}\\build\\Debug\\Intermediate\\",
                "/Fe:${workspaceFolder}\\build\\Debug\\Editor\\Editor.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Compiler(CL) , SolutionConfg(Debug) , Platform(Win32[x86])"
        },
        {
            "type": "shell",
            "label": "Compile ActiveFile (Debug)",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/c",
                "/std:c++17",
                "/W4",
                "/EHsc",
                "/Zi",
                "/I${workspaceFolder}\\include",
                "/I${workspaceFolder}\\include\\Systems",
                "/I${workspaceFolder}\\include\\Editor",
                "/I${workspaceFolder}\\include\\Editor\\Core",
                "/I${workspaceFolder}\\include\\Editor\\system",
                "/I${workspaceFolder}\\include\\Engine\\Core",
                "/I${workspaceFolder}\\include\\Engine\\utility",
                "/I${workspaceFolder}\\include\\Editor\\UI",
                "/I${workspaceFolder}\\include\\Editor\\UI\\Widget",
                "/I${workspaceFolder}\\include\\Editor\\UI\\Widget\\Base",
                "/I${workspaceFolder}\\ext\\imgui",
                "/I${workspaceFolder}\\deps\\glfw-3.4.bin.WIN32\\include",
                "/I${workspaceFolder}\\build\\Debug",
                "${file}",
                "/Fd:${workspaceFolder}\\build\\Debug\\Editor\\${fileBasenameNoExtension}.pdb",
                "/Fo:${workspaceFolder}\\build\\Debug\\Intermediate\\${fileBasenameNoExtension}.obj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Compiler(CL) , SolutionConfg(Debug) , Platform(Win32[x86])"
        },
        {
            "label": "Link Editor (Debug)",
            "type": "shell",
            "command": "link.exe",
            "args": [
                "/nologo",
                "/OUT:${workspaceFolder}\\build\\Debug\\Editor\\Editor.exe",
                "/DEBUG",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\Editor.obj",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\EditorGUISystem.obj",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\imgui.obj",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\imgui_demo.obj",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\imgui_draw.obj",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\imgui_tables.obj",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\imgui_widgets.obj",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\imgui_impl_glfw.obj",
                "${workspaceFolder}\\build\\Debug\\Intermediate\\imgui_impl_opengl2.obj",
                "opengl32.lib",
                "${workspaceFolder}\\deps\\glfw-3.4.bin.WIN32\\lib-vc2022\\glfw3dll.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Compile ActiveFile (Debug)",
            "problemMatcher": [],
            "group": "build",
            "detail": "Compiler(CL) , SolutionConfg(Debug) , Platform(Win32[x86])"
        },
        {
            "type": "shell",
            "label": "Build GameLauncher (Debug)",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/EHsc",
                "/Zi",
                "/Fd:${workspaceFolder}\\build\\Debug\\Editor\\BuildPipeline\\GameLauncher.pdb",
                "${workspaceFolder}\\src\\editor\\pipeline\\GameLauncher.cpp",
                "/INCREMENTAL",
                "/I",
                "${workspaceFolder}\\include",
                "/I",
                "${workspaceFolder}\\include\\SDK",
                "/Fo:${workspaceFolder}\\build\\Debug\\Intermediate\\BuildPipeline\\GameLauncher.obj",
                "/Fe:${workspaceFolder}\\build\\Debug\\Editor\\BuildPipeline\\GameLauncher.exe"
            ],
            "dependsOn": "Generate Build Folder",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Compiler(CL) , SolutionConfg(Debug) , Platform(Win32[x86])"
        },
        {
            "type": "shell",
            "label": "Run Editor (Debug)",
            "command": "cmd",
            "args": [
                "/C",
                "start ${workspaceFolder}\\build\\Debug\\Editor\\Editor.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Fast Open Editor (Debug)",
            "command": "cmd",
            "args": [
                "/C",
                "start ${workspaceFolder}\\build\\Debug\\Editor\\Editor.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Link Editor (Debug)",
            "group": "build",
            "detail": "Compiler(CL) , SolutionConfg(Debug) , Platform(Win32[x86])"
        },
        {
            "type": "shell",
            "label": "Copy Dependencies",
            "command": "cmd",
            "args": [
                "/c",
                "copy /Y \"${workspaceFolder}\\deps\\glfw-3.4.bin.WIN32\\lib-vc2022\\glfw3.dll\" \"${workspaceFolder}\\build\\Debug\\Editor\\\""
            ],
            "dependsOn": "Generate Build Folder",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Build Kernel [TEST] (Debug)",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/W4",
                "/EHsc",
                "/Zi",
                // "/I${workspaceFolder}\\include",
                // "/I${workspaceFolder}\\include\\Systems",
                // "/I${workspaceFolder}\\include\\Editor",
                // "/I${workspaceFolder}\\include\\Editor\\Core",
                // "/I${workspaceFolder}\\include\\Editor\\system",
                // "/I${workspaceFolder}\\include\\Engine\\Core",
                // "/I${workspaceFolder}\\include\\Engine\\utility",
                // "/I${workspaceFolder}\\include\\Editor\\UI",
                // "/I${workspaceFolder}\\include\\Editor\\UI\\Widget",
                // "/I${workspaceFolder}\\include\\Editor\\UI\\Widget\\Base",
                // "/I${workspaceFolder}\\ext\\imgui",
                // "/I${workspaceFolder}\\deps\\glfw-3.4.bin.WIN32\\include",
                // "/I${workspaceFolder}\\build\\Debug",
                // "opengl32.lib",
                // "${workspaceFolder}\\deps\\glfw-3.4.bin.WIN32\\lib-vc2022\\glfw3dll.lib",
                // "${workspaceFolder}/ext/imgui/*.cpp",
                // "${workspaceFolder}/ext/imgui/backends/imgui_impl_glfw.cpp",
                // "${workspaceFolder}/ext/imgui/backends/imgui_impl_opengl2.cpp",
                // "${workspaceFolder}/src/editor/systems/*.cpp",
                "${workspaceFolder}\\src\\Kernel\\Kernel.cpp",
                "/Fd:${workspaceFolder}\\build\\Debug\\Editor\\Kernel.pdb",
                "/Fo:${workspaceFolder}\\build\\Debug\\Intermediate\\",
                "/Fe:${workspaceFolder}\\build\\Debug\\Editor\\Kernel.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Compiler(CL) , SolutionConfg(Debug) , Platform(Win32[x86])"
        },
    ],
}